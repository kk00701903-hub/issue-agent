# 이 파일을 .env 로 복사해서 사용. .env 는 공유·업로드 금지.
ANTHROPIC_API_KEY=여기에_API_키

# 관리 화면 비밀번호(비우면 로그인 없이 열림 — 내 PC 혼자 쓸 때만)
HUB_PASSWORD=

# 라이선스 키(평가 30일 뒤 필요). 설정 탭에서 입력해도 됨
HUB_LICENSE_KEY=
# 선택: 다른 모델 제공자(쓸 때만, hub/config.json 의 model_routes 에서 작업별로 고름). 원고·사내 자료는 보내지 않음
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
STEPFUN_API_KEY=
DASHSCOPE_API_KEY=
MIMO_API_KEY=
OPENROUTER_API_KEY=
FREELLMAPI_KEY=
# 휴대폰으로 보기(같은 와이파이): 1 로 하면 집 안 공유기 주소에서도 열린다. HUB_PASSWORD 가 있어야 켜진다.
HUB_LAN=
